{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "NLog": {
        "internalLogLevel": "Info",
        "internalLogFile": "C:\\logs\\internal-nlog.txt",
        "extensions": [
            { "assembly": "NLog.Extensions.Logging" },
            { "assembly": "NLog.Web.AspNetCore" }
        ],
        "targets": {
            "my-file": {
                "type": "File",
                "fileName": "C:\\logs\\logfile-${shortdate}.log",
                "layout": "${longdate}|${level}|${logger}|${message}|${exception}"
            }
        },
        "rules": [
            {
                "logger": "*",
                "minLevel": "Error",
                "writeTo": "my-file"
            }
        ]
    },
    "ConnectionStrings": {
        "DefaultConnection": "Host=localhost;Port=5432;Database=Lab3Db;Username=postgres;Password=postgres"
    }

}